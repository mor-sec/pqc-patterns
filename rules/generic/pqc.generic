# ruleid: pqc-tls-godebug-downgrade
ENV GODEBUG=tlsmlkem=0
# ruleid: pqc-tls-godebug-downgrade
GODEBUG: "http2client=0,tlssecpmlkem=0"
# ok: pqc-tls-godebug-downgrade
ENV GODEBUG=http2client=0
# ruleid: pqc-tls-godebug-downgrade
JAVA_OPTS=-Djdk.tls.namedGroups=x25519,secp256r1
# ok: pqc-tls-godebug-downgrade
JAVA_OPTS=-Djdk.tls.namedGroups=X25519MLKEM768,x25519
